# =============================================================================
# EVENT TICKETING PLATFORM - LOCAL DEVELOPMENT ENVIRONMENT (.env)
# =============================================================================

# 1. PostgreSQL
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=ticketing_db
POSTGRES_PORT=5432

PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=password

# 2. MongoDB
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=rootpassword
MONGO_PORT=27017

# 3. Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# 4. Apache Kafka
KAFKA_PORT=9092
KAFKA_UI_PORT=8085
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# 5. OpenLDAP
LDAP_ORGANISATION=Example Org
LDAP_DOMAIN=example.org
LDAP_ADMIN_PASSWORD=adminpassword
LDAP_PORT=389

# 6. Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# 7. Keycloak IAM
KEYCLOAK_PORT=8443
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

KEYCLOAK_SERVER_URL=http://localhost:8443
KEYCLOAK_REALM=event-ticketing
KEYCLOAK_ISSUER_URI=http://localhost:8443/realms/event-ticketing
KEYCLOAK_CLIENT_SECRET=secret

# 8. Google OAuth2 Identity Provider
GOOGLE_CLIENT_ID=your-google-client-id-hint.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-hint

# 9. Application URLs
FRONTEND_URL=http://localhost:3000
BFF_SERVICE_URL=http://localhost:8080
API_GATEWAY_URL=http://localhost:8081
