{
  "realm": "event-ticketing",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@event-ticketing.local",
    "fromDisplayName": "Event Ticketing System",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "vi"
  ],
  "defaultLocale": "en",
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "updateProfileFirstLoginMode": "on",
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID:your-google-client-id-hint.apps.googleusercontent.com}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET:your-google-client-secret-hint}",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT",
        "useJwksUrl": "true"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "google-email-mapper",
      "identityProviderAlias": "google",
      "identityProviderMapper": "google-user-attribute-mapper",
      "config": {
        "user.attribute": "email",
        "jsonField": "email",
        "syncMode": "INHERIT"
      }
    },
    {
      "name": "google-first-name-mapper",
      "identityProviderAlias": "google",
      "identityProviderMapper": "google-user-attribute-mapper",
      "config": {
        "user.attribute": "firstName",
        "jsonField": "given_name",
        "syncMode": "INHERIT"
      }
    },
    {
      "name": "google-last-name-mapper",
      "identityProviderAlias": "google",
      "identityProviderMapper": "google-user-attribute-mapper",
      "config": {
        "user.attribute": "lastName",
        "jsonField": "family_name",
        "syncMode": "INHERIT"
      }
    },
    {
      "name": "google-default-customer-role",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-hardcoded-role-idp-mapper",
      "config": {
        "role": "CUSTOMER",
        "syncMode": "INHERIT"
      }
    }
  ],
  "requiredActions": [
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": true,
      "priority": 50
    },
    {
      "alias": "UPDATE_EMAIL",
      "name": "Update Email",
      "providerId": "UPDATE_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 60
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 20
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Quản trị viên toàn hệ thống"
      },
      {
        "name": "CUSTOMER",
        "description": "Khách hàng mua vé thông thường"
      },
      {
        "name": "STAFF",
        "description": "Nhân viên kiểm soát vé và vận hành sự kiện"
      },
      {
        "name": "ORGANIZER",
        "description": "Nhà tổ chức sự kiện"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "event:read",
      "description": "Cho phép xem danh sách và chi tiết sự kiện",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "event:write",
      "description": "Cho phép tạo, cập nhật và hủy sự kiện",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "inventory:read",
      "description": "Cho phép xem số lượng vé tồn kho",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "inventory:manage",
      "description": "Cho phép cấu hình và điều chỉnh số lượng vé kho",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "order:read",
      "description": "Cho phép xem lịch sử đơn hàng",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "order:create",
      "description": "Cho phép đặt mua vé và tạo đơn hàng",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "order:cancel",
      "description": "Cho phép hủy đơn hàng",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "payment:create",
      "description": "Cho phép thực hiện thanh toán vé",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "payment:refund",
      "description": "Cho phép hoàn tiền giao dịch vé",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "ticket:read",
      "description": "Cho phép xem chi tiết vé điện tử và mã QR",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "ticket:checkin",
      "description": "Cho phép quét mã QR và check-in vé tại sự kiện",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    }
  ],
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "id": "ldap-enterprise-provider",
        "name": "ldap-enterprise",
        "providerId": "ldap",
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "id": "username-mapper",
              "name": "username",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["uid"],
                "is.mandatory.in.ldap": ["true"],
                "always.read.value.from.ldap": ["false"],
                "user.model.attribute": ["username"],
                "read.only": ["true"]
              }
            },
            {
              "id": "email-mapper",
              "name": "email",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["mail"],
                "is.mandatory.in.ldap": ["false"],
                "always.read.value.from.ldap": ["false"],
                "user.model.attribute": ["email"],
                "read.only": ["true"]
              }
            },
            {
              "id": "first-name-mapper",
              "name": "first name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["givenName"],
                "is.mandatory.in.ldap": ["false"],
                "always.read.value.from.ldap": ["false"],
                "user.model.attribute": ["firstName"],
                "read.only": ["true"]
              }
            },
            {
              "id": "last-name-mapper",
              "name": "last name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["sn"],
                "is.mandatory.in.ldap": ["true"],
                "always.read.value.from.ldap": ["false"],
                "user.model.attribute": ["lastName"],
                "read.only": ["true"]
              }
            },
            {
              "id": "customer-role-mapper",
              "name": "customer role",
              "providerId": "hardcoded-ldap-role-mapper",
              "config": {
                "role": ["CUSTOMER"]
              }
            }
          ]
        },
        "config": {
          "enabled": ["true"],
          "importEnabled": ["true"],
          "priority": ["0"],
          "editMode": ["READ_ONLY"],
          "syncRegistrations": ["false"],
          "vendor": ["other"],
          "usernameLDAPAttribute": ["uid"],
          "rdnLDAPAttribute": ["uid"],
          "uuidLDAPAttribute": ["entryUUID"],
          "userObjectClasses": ["inetOrgPerson"],
          "connectionUrl": ["ldap://openldap:389"],
          "usersDn": ["ou=users,dc=example,dc=org"],
          "authType": ["simple"],
          "bindDn": ["cn=admin,dc=example,dc=org"],
          "bindCredential": ["adminpassword"],
          "searchScope": ["1"],
          "validatePasswordPolicy": ["false"],
          "trustEmail": ["true"],
          "useTruststoreSpi": ["ldapsOnly"],
          "startTls": ["false"],
          "connectionPooling": ["true"],
          "pagination": ["true"],
          "batchSizeForSync": ["1000"],
          "changedSyncPeriod": ["300"],
          "fullSyncPeriod": ["86400"]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "bff-client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "secret",
      "redirectUris": [
        "http://localhost:8080/api/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080##http://localhost:3000##+"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email",
        "event:read",
        "inventory:read",
        "ticket:read"
      ],
      "optionalClientScopes": [
        "event:write",
        "inventory:manage",
        "order:read",
        "order:create",
        "order:cancel",
        "payment:create",
        "payment:refund",
        "ticket:checkin"
      ],
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        },
        {
          "name": "email_verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "emailVerified",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email_verified",
            "jsonType.label": "boolean"
          }
        },
        {
          "name": "locale",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "locale",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "locale",
            "jsonType.label": "String"
          }
        },
        {
          "name": "birth_year",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "birth_year",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "birth_year",
            "jsonType.label": "String"
          }
        },
        {
          "name": "api-client-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "api-client",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "api-client",
      "name": "Backend Microservices Resource Server",
      "description": "Resource server đại diện cho các API microservices phía sau",
      "enabled": true,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "customer1",
      "enabled": true,
      "email": "customer1@example.com",
      "firstName": "John",
      "lastName": "Customer",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "CUSTOMER"
      ],
      "attributes": {
        "birth_year": [
          "1990"
        ],
        "locale": [
          "en"
        ]
      }
    },
    {
      "username": "admin1",
      "enabled": true,
      "email": "admin1@example.com",
      "firstName": "Super",
      "lastName": "Admin",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN"
      ]
    },
    {
      "username": "organizer1",
      "enabled": true,
      "email": "organizer1@example.com",
      "firstName": "Event",
      "lastName": "Organizer",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ORGANIZER"
      ]
    }
  ],
  "scopeMappings": [
    {
      "clientScope": "event:read",
      "roles": ["CUSTOMER", "ORGANIZER", "STAFF", "ADMIN"]
    },
    {
      "clientScope": "event:write",
      "roles": ["ORGANIZER", "ADMIN"]
    },
    {
      "clientScope": "inventory:read",
      "roles": ["CUSTOMER", "ORGANIZER", "ADMIN"]
    },
    {
      "clientScope": "inventory:manage",
      "roles": ["ORGANIZER", "ADMIN"]
    },
    {
      "clientScope": "order:read",
      "roles": ["CUSTOMER", "ORGANIZER", "ADMIN"]
    },
    {
      "clientScope": "order:create",
      "roles": ["CUSTOMER", "ADMIN"]
    },
    {
      "clientScope": "order:cancel",
      "roles": ["CUSTOMER", "ADMIN"]
    },
    {
      "clientScope": "payment:create",
      "roles": ["CUSTOMER", "ADMIN"]
    },
    {
      "clientScope": "payment:refund",
      "roles": ["ADMIN"]
    },
    {
      "clientScope": "ticket:read",
      "roles": ["CUSTOMER", "ORGANIZER", "STAFF", "ADMIN"]
    },
    {
      "clientScope": "ticket:checkin",
      "roles": ["STAFF", "ADMIN"]
    }
  ]
}
