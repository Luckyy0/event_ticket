# =============================================================================
# EVENT TICKETING PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================
# Hướng dẫn: Tạo bản sao file này thành `.env` (không commit `.env` lên git)
# và thay thế các thông tin bí mật trước khi khởi chạy hệ thống.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. POSTGRESQL (Cơ sở dữ liệu quan hệ cho Core Microservices & Keycloak)
# -----------------------------------------------------------------------------
POSTGRES_USER=ticketing_admin
POSTGRES_PASSWORD=PostgresSecurePassword123!
POSTGRES_DB=ticketing_db
POSTGRES_PORT=5432

# pgAdmin (Web-based Management UI for PostgreSQL)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=PgAdminSecurePassword123!

# Keycloak PostgreSQL User & Password
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=KeycloakDbSecurePassword123!

# -----------------------------------------------------------------------------
# 2. MONGODB (Cơ sở dữ liệu tài liệu cho Event Catalog Service)
# -----------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=mongo_admin
MONGO_INITDB_ROOT_PASSWORD=MongoSecurePassword123!
MONGO_PORT=27017

# -----------------------------------------------------------------------------
# 3. REDIS (Bộ nhớ đệm / Khóa phân tán Distributed Lock & Session)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# 4. APACHE KAFKA (Message Broker trong KRaft Mode)
# -----------------------------------------------------------------------------
KAFKA_PORT=9092
KAFKA_UI_PORT=8085
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# -----------------------------------------------------------------------------
# 5. OPENLDAP (Nguồn định danh doanh nghiệp Mock)
# -----------------------------------------------------------------------------
LDAP_ORGANISATION=Example Org
LDAP_DOMAIN=example.org
LDAP_ADMIN_PASSWORD=LdapAdminSecurePassword123!
LDAP_PORT=389

# -----------------------------------------------------------------------------
# 6. MAILPIT (Mock SMTP Server & Web Inbox cho Verify Email)
# -----------------------------------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# -----------------------------------------------------------------------------
# 7. KEYCLOAK IAM (Quản lý định danh & Phân quyền tập trung)
# -----------------------------------------------------------------------------
KEYCLOAK_PORT=8443
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=KeycloakAdminSecurePassword123!

KEYCLOAK_SERVER_URL=http://localhost:8443
KEYCLOAK_REALM=event-ticketing
KEYCLOAK_ISSUER_URI=http://localhost:8443/realms/event-ticketing
KEYCLOAK_CLIENT_SECRET=BffClientSecretSecure123!

# -----------------------------------------------------------------------------
# 8. GOOGLE OAUTH2 IDENTITY PROVIDER (Tích hợp đăng nhập Google qua Keycloak)
# Đăng ký tại Google Cloud Console > Credentials > OAuth 2.0 Client IDs
# Callback URI: http://localhost:8443/realms/event-ticketing/broker/google/endpoint
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# 9. APPLICATION URLS & GATEWAYS
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
BFF_SERVICE_URL=http://localhost:8080
API_GATEWAY_URL=http://localhost:8081
