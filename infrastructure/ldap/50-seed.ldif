# Define organizational unit for users
dn: ou=users,dc=example,dc=org
objectClass: organizationalUnit
ou: users

# Enterprise User 1
dn: uid=ldap_john,ou=users,dc=example,dc=org
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: shadowAccount
uid: ldap_john
sn: Doe
givenName: John
cn: John Doe
displayName: John Doe (Enterprise)
mail: john.doe@enterprise.example.org
userPassword: enterprisePassword123
uidNumber: 10001
gidNumber: 10001
homeDirectory: /home/ldap_john

